<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Black, no action bar, no window background of its own. The panel is a
        480x480 circle of the agent's own making, and anything the system draws
        around it shows up as a visible edge on the real device.
    -->
    <style name="Theme.Spotdash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>

    <style name="Theme.Spotdash.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
        Granted only through Settings or adb, never by a prompt. The bridge
        treats it as optional and logs when it is missing, so the same build
        runs unchanged on an emulator where it is not granted.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Spotdash"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".PanelActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="nosensor"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.Spotdash">

            <!-- Normal launcher entry, so it can be started before it is the
                 default home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- HOME and DEFAULT together are what let LineageOS offer this as
                 the default launcher, which is how the panel survives a reboot
                 without anyone touching the device. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>

# Secrets. config.json holds the shared bearer token and must never be committed.
config.json
agent/config.json

# Per-source runtime state, such as the Spotify refresh token. Written by the
# agent itself, holds real credentials, never hand-edited, never committed.
spotify_state.json
agent/spotify_state.json
spotify_art.*
agent/spotify_art.*
*_state.json

# Go build output
/agent/spotdash
/agent/spotdash.exe
/agent/dist/
*.exe
*.exe~
*.test
*.out

# Agent runtime output
*.log
agent/logs/

# Android / Gradle
shell/.gradle/
shell/build/
shell/app/build/
shell/local.properties
shell/captures/
*.apk
*.aab
*.keystore
*.jks

# Git worktrees used for isolated feature work
.worktrees/

# Editors and OS
.idea/
.vscode/
*.iml
Thumbs.db
desktop.ini

# Local planning notes, not part of the project
spotdash-kickoff-prompt.md

# Design mockups and scratch images, not part of the build
mockups/
artcover.png
Screenshot*.png
